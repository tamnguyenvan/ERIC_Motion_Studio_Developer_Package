{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eric.local/schemas/gesture-lexicon-v1.schema.json",
  "title": "ERIC Deterministic Gesture Lexicon V1",
  "type": "object",
  "required": ["schema_version", "actions", "effectors", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "effectors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["canonical_id", "actions", "effectors"],
        "properties": {
          "canonical_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "effectors": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "effector_optional": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
