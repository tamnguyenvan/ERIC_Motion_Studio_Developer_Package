{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eric.local/schemas/pose-v1.schema.json",
  "title": "ERIC Motion Studio Pose V1",
  "type": "object",
  "required": [
    "schema",
    "simulation_only",
    "joint_offsets_rad"
  ],
  "properties": {
    "schema": {
      "const": "eric_motion_studio_pose_v1"
    },
    "simulation_only": {
      "type": "boolean"
    },
    "pose_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "pose_name": {
      "type": "string",
      "minLength": 1
    },
    "pose_description": {
      "type": "string"
    },
    "pose_aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "pose_tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "pose_body_regions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "library_origin": {
      "enum": ["builtin", "user"]
    },
    "joint_offsets_rad": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  }
}
