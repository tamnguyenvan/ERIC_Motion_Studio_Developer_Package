{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eric.local/schemas/brainos-motion-v1.schema.json",
  "title": "BrainOS Local Motion Package V1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "source",
    "simulation_only",
    "motion_name",
    "total_duration_ms",
    "keyframes"
  ],
  "properties": {
    "schema": {
      "const": "brainos_motion_package_v1"
    },
    "version": {
      "const": 1
    },
    "source": {
      "const": "ERIC Motion Studio"
    },
    "simulation_only": {
      "const": true
    },
    "motion_name": {
      "type": "string",
      "minLength": 1
    },
    "total_duration_ms": {
      "type": "integer",
      "minimum": 100
    },
    "keyframes": {
      "type": "array",
      "minItems": 1
    }
  }
}
