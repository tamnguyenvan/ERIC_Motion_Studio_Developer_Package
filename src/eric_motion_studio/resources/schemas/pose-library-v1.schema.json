{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eric.local/schemas/pose-library-v1.schema.json",
  "title": "ERIC Motion Studio Built-in Pose Library V1",
  "type": "object",
  "required": ["schema_version", "poses"],
  "properties": {
    "schema_version": {"const": 1},
    "poses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "source_pose",
          "description",
          "aliases",
          "tags",
          "body_regions"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "source_pose": {"type": "string", "minLength": 1},
          "mirror_arms": {"type": "boolean"},
          "description": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "body_regions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
