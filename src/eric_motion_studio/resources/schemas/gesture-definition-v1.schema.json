{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eric.local/schemas/gesture-definition-v1.schema.json",
  "title": "ERIC Gesture Definition Registry V1",
  "type": "object",
  "required": ["schema_version", "definitions"],
  "properties": {
    "schema_version": {"const": 1},
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "canonical_id",
          "aliases",
          "supported_slots",
          "generator_id",
          "defaults",
          "tags",
          "constraints"
        ],
        "properties": {
          "canonical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "triggers": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "supported_slots": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "side",
                "direction",
                "speed",
                "intensity",
                "hold",
                "sequence",
                "neutral_return"
              ]
            }
          },
          "generator_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "defaults": {"type": "object"},
          "tags": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "constraints": {
            "type": "object",
            "required": [
              "min_amplitude_rad",
              "max_duration_seconds",
              "requires_neutral_return",
              "balance_required",
              "collision_check"
            ]
          }
        }
      }
    }
  }
}
